# Optional production origin used by the Publish action.
# Leave unset for automatic LAN IPv4 mode during local Wi-Fi testing.
LIVESLIDES_PUBLIC_BASE_URL=https://brochure.example.com

# Optional local viewer port used when composing the automatic LAN URL.
LIVESLIDES_VIEWER_PORT=5193

# Optional ffmpeg executable path; otherwise resolved from PATH.
# LIVESLIDES_FFMPEG=C:\tools\ffmpeg\bin\ffmpeg.exe
